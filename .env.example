# Redemption Guard — Studio Next (CLI network: studio-dev, genlayer-js: studioDevnet, chain 61997)
# Copy to .env. Never commit .env.

# Deployer key used by scripts/deploy.ts, seed-demo.ts, smoke-studio.ts.
# Leave empty: the scripts generate a Studio-Next-only key, append it to .env,
# and fund it with the Studio Next faucet RPC (sim_fundAccount). Never printed.
DEPLOYER_PRIVATE_KEY=

# Public base URL that serves frontend/public/evidence/*.html over HTTPS.
# Its hostname is registered on-chain as the demo assets' issuer domain.
FIXTURE_BASE_URL=https://redemption-guard.vercel.app

# Optional override for explorer links.
EXPLORER_URL=https://explorer-studio-dev.genlayer.com
