# Optional. By default the app reads lib/deployment.generated.json written by `npm run deploy`.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Optional v2 opt-in. Leave blank to keep the verified v1 board as the default.
NEXT_PUBLIC_V2_CONTRACT_ADDRESS=
# Set to v2 only after deploying and verifying the separate v2 contract.
NEXT_PUBLIC_DEPLOYMENT_VERSION=v1
NEXT_PUBLIC_FIXTURE_BASE_URL=https://redemption-guard.vercel.app
